[Unit]
Description=ARKOS Frontend
After=network.target

[Service]
Type=simple
User=arkos
Group=arkos
WorkingDirectory=/opt/arkos-frontend
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=ARKOS_API_BASE=http://127.0.0.1:30000/v1
Environment=ARKOS_SERVER_PORT=3001
Environment=ARKOS_QUERY_TIMEOUT_MS=30000
Environment=NVM_DIR=/home/arkos/.nvm
ExecStart=/opt/arkos-frontend/scripts/start-production-api.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
